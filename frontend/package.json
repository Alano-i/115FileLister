    "mobx-react": "^9.1.0",
    "prismjs": "^1.30.0",
    "qs": "^6.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "react-waypoint": "^10.3.0",
